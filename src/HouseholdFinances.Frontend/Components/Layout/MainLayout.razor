@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeService ThemeService
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation

<MudThemeProvider Theme="@ThemeService.Theme" @bind-IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="Toggle navigation menu" />
        <MudText Typo="Typo.h6" Class="ml-2">Household Finances</MudText>
        <MudSpacer />
        @if (_isSignedIn)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit"
                           OnClick="SignOutAsync"
                           aria-label="Sign out"
                           data-testid="signout" />
        }
        <MudIconButton Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ThemeService.ToggleDarkMode"
                       aria-label="Toggle dark mode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Household Finances</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isSignedIn;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _isSignedIn = await AuthenticationService.HasSessionAsync();
    }

    // The layout outlives a single page, so signing in on the login page or signing out here only
    // becomes visible on navigation. Re-checking keeps the control in step with the session.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var isSignedIn = await AuthenticationService.HasSessionAsync();

        if (isSignedIn == _isSignedIn)
        {
            return;
        }

        _isSignedIn = isSignedIn;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SignOutAsync()
    {
        try
        {
            await AuthenticationService.SignOutAsync();
        }
        catch (Exception)
        {
            // Reaching the login page matters more than the failure: the session check there
            // reports the truth either way.
        }

        _isSignedIn = false;
        Navigation.NavigateTo("/login");
    }

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
