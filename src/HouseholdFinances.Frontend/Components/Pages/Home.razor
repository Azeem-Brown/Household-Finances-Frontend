@page "/"

<PageTitle>Household Finances</PageTitle>

<PageHeader Title="Household Finances" Subtitle="Family expense planner" />

<MudPaper Class="pa-6" Elevation="1">
    <MudText Typo="Typo.h6" GutterBottom="true">Welcome</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        This is the MudBlazor frontend shell. Use the navigation menu to reach each placeholder page.
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="/dashboard"
               StartIcon="@Icons.Material.Filled.Dashboard">
        Go to Household Dashboard
    </MudButton>
</MudPaper>
