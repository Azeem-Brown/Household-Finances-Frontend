@page "/dashboard"
@using System.Globalization
@using HouseholdFinances.Frontend.Models
@inject IApiClient ApiClient
@inject TimeProvider Clock
@inject PeriodSelectionService PeriodSelection

<PageTitle>Household Dashboard | Household Finances</PageTitle>

<PageHeader Title="Household Dashboard" Subtitle="An overview of your household finances." />

@if (_errorMessage is not null)
{
    <div data-testid="dashboard-error">
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    </div>
}
else if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" data-testid="dashboard-loading" />
}
else if (_household is null)
{
    <MudPaper Class="pa-6" Elevation="1" data-testid="dashboard-no-household">
        <MudText Typo="Typo.body1">@NoHouseholdMessage</MudText>
    </MudPaper>
}
else
{
    <div class="d-flex align-center flex-wrap gap-4 mb-4">
        <MudText Typo="Typo.subtitle1">@HouseholdName</MudText>

        <MudSelect T="Interval"
                   Value="SelectedPeriod"
                   ValueChanged="OnPeriodChanged"
                   Label="Period"
                   Variant="Variant.Outlined"
                   Dense="true"
                   Style="min-width: 12rem;"
                   data-testid="dashboard-period">
            @foreach (Interval interval in Intervals)
            {
                <MudSelectItem T="Interval" Value="@interval">@interval</MudSelectItem>
            }
        </MudSelect>
    </div>

    @if (IsEmpty)
    {
        <MudPaper Class="pa-6" Elevation="1" data-testid="dashboard-empty">
            <MudText Typo="Typo.h6" GutterBottom="true">Nothing to summarise yet</MudText>
            <MudText Typo="Typo.body1">@EmptyStateMessage</MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudCard Elevation="1" Class="pa-4 h-100">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Total income</MudText>
                    <MudText Typo="Typo.h5"><span data-testid="dashboard-income">@IncomeText</span></MudText>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="1" Class="pa-4 h-100">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Total expenses</MudText>
                    <MudText Typo="Typo.h5"><span data-testid="dashboard-expenses">@ExpensesText</span></MudText>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="1" Class="pa-4 h-100">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Remaining balance</MudText>
                    <MudText Typo="Typo.h5"><span data-testid="dashboard-balance">@BalanceText</span></MudText>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4 mt-4" Elevation="1" data-testid="dashboard-allocation">
        <MudText Typo="Typo.h6" GutterBottom="true">Split your remaining balance</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">@AllocationHintMessage</MudText>

        @if (_allocationErrorMessage is not null)
        {
            <div data-testid="dashboard-allocation-error">
                <MudAlert Severity="Severity.Error" Class="mb-4">@_allocationErrorMessage</MudAlert>
            </div>
        }

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudNumericField T="double"
                                 @bind-Value="_savings"
                                 Label="Savings"
                                 Variant="Variant.Outlined"
                                 Culture="@CultureInfo.InvariantCulture"
                                 Error="_savingsError is not null"
                                 ErrorText="@_savingsError"
                                 data-testid="dashboard-allocation-savings" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="double"
                                 @bind-Value="_funMoney"
                                 Label="Fun money"
                                 Variant="Variant.Outlined"
                                 Culture="@CultureInfo.InvariantCulture"
                                 Error="_funMoneyError is not null"
                                 ErrorText="@_funMoneyError"
                                 data-testid="dashboard-allocation-fun" />
            </MudItem>
        </MudGrid>

        <div class="d-flex mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Allocate"
                       data-testid="dashboard-allocation-submit">
                Allocate
            </MudButton>
        </div>

        @if (_allocation is { } allocation)
        {
            <div data-testid="dashboard-allocation-result">
                <MudGrid Class="mt-4">
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Allocated to savings</MudText>
                        <MudText Typo="Typo.h6"><span data-testid="dashboard-allocation-savings-value">@MoneyFormatter.Format(allocation.Savings)</span></MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Allocated to fun money</MudText>
                        <MudText Typo="Typo.h6"><span data-testid="dashboard-allocation-fun-value">@MoneyFormatter.Format(allocation.FunMoney)</span></MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Unallocated remainder</MudText>
                        <MudText Typo="Typo.h6"><span data-testid="dashboard-allocation-remainder">@UnallocatedText</span></MudText>
                    </MudItem>
                </MudGrid>
            </div>
        }
        </MudPaper>
    }
}

@code {
    /// <summary>The authenticated endpoint that lists the current user's households with their totals.</summary>
    public const string HouseholdsPath = "/api/v1/households";

    /// <summary>
    /// Builds the household list endpoint for a calendar period. The period is sent as the
    /// <see cref="Interval"/> member name (for example <c>BiWeekly</c>), which the API parses, so
    /// the dashboard sends only the selection and never computes a date window itself.
    /// </summary>
    /// <param name="period">The period whose totals should be returned.</param>
    /// <returns>The API path for the household totals in that period.</returns>
    public static string HouseholdsPathFor(Interval period) => $"{HouseholdsPath}?period={period}";

    /// <summary>Guidance shown when the household has no income or bill data yet.</summary>
    public const string EmptyStateMessage =
        "Add income and bills to see your total income, expenses, and remaining balance.";

    /// <summary>Guidance shown when the current user has no household to summarise.</summary>
    public const string NoHouseholdMessage =
        "No household was found for your account. Create one to see your dashboard.";

    /// <summary>Guidance shown above the savings and fun-money allocation inputs.</summary>
    public const string AllocationHintMessage =
        "Choose how much of the remaining balance goes to savings and fun money. "
        + "This split is not saved and resets when you reload or leave the dashboard.";

    /// <summary>Client-side message shown when an allocated amount is negative.</summary>
    public const string NegativeAmountMessage = "Enter an amount of zero or more.";

    /// <summary>
    /// Client-side message shown when the savings and fun-money split is larger than the remaining
    /// balance.
    /// </summary>
    public const string AllocationExceedsBalanceMessage =
        "Savings plus fun money cannot be more than the remaining balance.";

    /// <summary>
    /// The cadence options, in the order fixed by the Interval decision (#4): Daily, Weekly,
    /// BiWeekly, Monthly, Quarterly, Yearly.
    /// </summary>
    public static readonly IReadOnlyList<Interval> Intervals = new[]
    {
        Interval.Daily,
        Interval.Weekly,
        Interval.BiWeekly,
        Interval.Monthly,
        Interval.Quarterly,
        Interval.Yearly
    };

    private Household? _household;
    private bool _isLoading = true;
    private string? _errorMessage;

    // Allocation is session-only page state (see the decision recorded on issue #16): the split is
    // held in memory here and never sent to the API, so it does not persist and resets when the
    // page is reloaded or the user navigates away from the dashboard.
    private double _savings;
    private double _funMoney;
    private string? _savingsError;
    private string? _funMoneyError;
    private string? _allocationErrorMessage;
    private (double Savings, double FunMoney)? _allocation;

    // The empty state is shown when there is neither income nor bill data, so a new user is guided
    // to add entries instead of being shown a bare zero.
    private bool IsEmpty =>
        _household is not null && _household.Incomes == 0 && _household.Payments == 0;

    private string HouseholdName => _household?.Name ?? string.Empty;

    private string IncomeText => MoneyFormatter.Format(_household?.Incomes ?? 0);

    private string ExpensesText => MoneyFormatter.Format(_household?.Payments ?? 0);

    private string BalanceText => MoneyFormatter.Format(RemainingBalance);

    // The raw remaining balance the allocation is validated against, before any formatting.
    private double RemainingBalance => (_household?.Incomes ?? 0) - (_household?.Payments ?? 0);

    // What is left of the remaining balance after the accepted split; only meaningful once a split
    // has been accepted, which is the only time it is shown.
    private string UnallocatedText =>
        _allocation is { } allocation
            ? MoneyFormatter.Format(RemainingBalance - allocation.Savings - allocation.FunMoney)
            : MoneyFormatter.Format(RemainingBalance);

    // The period control reads and writes the shared circuit-scoped selection, so the Dashboard,
    // Income, and Bills always agree on the window. There is no page-local period field.
    private Interval SelectedPeriod => PeriodSelection.Period;

    // A changed period reloads the household totals from the API, which is the only place the
    // window is applied. The accepted split and its messages are discarded because they were
    // validated against the previous balance; the allocation inputs and rules are unchanged.
    private async Task OnPeriodChanged(Interval period)
    {
        if (PeriodSelection.Period == period)
        {
            return;
        }

        PeriodSelection.Period = period;
        ClearAllocationState();

        await LoadAsync();
    }

    private void ClearAllocationState()
    {
        _allocation = null;
        _savingsError = null;
        _funMoneyError = null;
        _allocationErrorMessage = null;
    }

    // Client-side validation mirrors the issue's rules: each amount must be non-negative and the
    // two amounts together must not exceed the remaining balance. Amounts are rounded to the decided
    // money precision first so validation and display agree on the same value.
    private void Allocate()
    {
        _savingsError = null;
        _funMoneyError = null;
        _allocationErrorMessage = null;

        var savings = MoneyFormatter.Round(_savings);
        var funMoney = MoneyFormatter.Round(_funMoney);

        _savingsError = savings < 0 ? NegativeAmountMessage : null;
        _funMoneyError = funMoney < 0 ? NegativeAmountMessage : null;

        if (_savingsError is null && _funMoneyError is null && savings + funMoney > RemainingBalance)
        {
            _allocationErrorMessage = AllocationExceedsBalanceMessage;
        }

        // A rejected split clears any previously accepted one, so the page never shows a stale
        // result next to a fresh error.
        _allocation = _savingsError is null && _funMoneyError is null && _allocationErrorMessage is null
            ? (savings, funMoney)
            : null;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        // The period this request was issued for. A response is applied only if its period is still
        // the selected one, so a slow earlier response cannot overwrite a newer selection.
        Interval requestedPeriod = PeriodSelection.Period;

        try
        {
            IReadOnlyList<Household> households =
                await ApiClient.GetAsync<IReadOnlyList<Household>>(HouseholdsPathFor(requestedPeriod));

            if (PeriodSelection.Period != requestedPeriod)
            {
                return;
            }

            // The backend returns the list ordered by name. The dashboard summarises a single
            // household, so it predicts a stable subject by taking the first one.
            _household = households.FirstOrDefault();
        }
        catch (ClientErrorException exception)
        {
            // Every API failure already carries the shared convention message and its significant
            // identifier (for example "Unauthorized 7"). A stale failure is ignored like a stale
            // response.
            if (PeriodSelection.Period == requestedPeriod)
            {
                _errorMessage = exception.Message;
            }
        }
        catch (Exception exception)
        {
            // Unexpected failures still surface through the shared convention rather than an
            // unhandled circuit error or a silent blank page.
            if (PeriodSelection.Period == requestedPeriod)
            {
                _errorMessage = ClientErrorFormatter.Format(ClientErrorCode.Unknown, exception.GetType().Name);
            }
        }
        finally
        {
            // Only the request for the current selection may end the loading state; a newer request
            // owns it otherwise.
            if (PeriodSelection.Period == requestedPeriod)
            {
                _isLoading = false;
            }
        }
    }
}
